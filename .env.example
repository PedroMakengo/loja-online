# Copiar para .env (XAMPP ou docker compose local). No Coolify, definir em Environment Variables.
AMBIENTE=prod
PAGAMENTOS_SIMULADOS=1
EMAIL_DRIVER=log
EMAIL_LOJA=geral@diotekno.ao
DB_NOME=diotekno_loja

# Entrar com o Google (opcional) — Google Cloud Console → Credenciais → ID do cliente OAuth (Aplicação Web)
# URI de redireccionamento autorizado: https://<o-seu-dominio>/entrar/google/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://<o-seu-dominio>/entrar/google/retorno
