# Copiar para .env (XAMPP ou docker compose local). No Coolify, definir em Environment Variables.
AMBIENTE=prod
PAGAMENTOS_SIMULADOS=1
EMAIL_LOJA=geral@diotekno.ao
# Endereço público usado nos links dos emails enviados pelo cron (ex.: https://diotekno.ao)
URL_SITE=

# Emails por SMTP do Gmail — Conta Google → Segurança → Verificação em 2 passos → Senhas de app.
# Com SMTP_HOST definido o envio é real; sem ele (ou EMAIL_DRIVER=log) os emails ficam em storage/logs/emails.log.
# EMAIL_DRIVER=log
SMTP_HOST=
SMTP_PORTA=587
SMTP_UTILIZADOR=
SMTP_SENHA=
# EMAIL_REMETENTE=      (padrão: SMTP_UTILIZADOR — o Gmail só aceita a própria conta ou um alias verificado)
# EMAIL_NOTIFICACOES=   (avisos internos de pedidos; padrão: EMAIL_LOJA; "nao" desliga)
DB_NOME=diotekno_loja

# Entrar com o Google (opcional) — Google Cloud Console → Credenciais → ID do cliente OAuth (Aplicação Web)
# URI de redireccionamento autorizado: https://<o-seu-dominio>/entrar/google/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://<o-seu-dominio>/entrar/google/retorno
